# ─────────────────────────────────────────────────────────────────────────────
# Nexus AI Platform — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# development | production

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Fernet key for encrypting API keys at rest (REQUIRED for key storage)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# JWT expiry in minutes (default: 1440 = 24 hours)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus_ai
# Or set a full connection string (overrides individual vars above):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Gemini Web Proxy (FREE tier) ─────────────────────────────────────────────
# Set up: https://github.com/your-org/gemini-web2api
# For local dev: http://localhost:8081/v1
# For Docker compose: http://host.docker.internal:8081/v1
GEMINI_PROXY_URL=http://localhost:8081/v1
GEMINI_PROXY_KEY=nexus-local-key

# ── Optional Paid Providers ───────────────────────────────────────────────────
# Leave blank to disable. Users can also add their own keys in Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Ollama local LLM (optional)
OLLAMA_BASE_URL=http://localhost:11434

# ── MinIO / S3 File Storage ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=nexus-files

# ── File Upload ────────────────────────────────────────────────────────────────
# Maximum file size in bytes (default: 20971520 = 20 MB)
# MAX_FILE_SIZE_BYTES=20971520
